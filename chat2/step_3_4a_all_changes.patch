+    bad = []
+    for s, n, p in _walk_props(contract["components"]["schemas"]):
+        xs = p.get("x-source")
+        if not xs:
+            continue
+        if "column" in xs and (xs["table"], xs["column"]) not in cols:
+            bad.append(f"{s}.{n} -> {xs['table']}.{xs['column']}")
+        if "field_name" in xs:
