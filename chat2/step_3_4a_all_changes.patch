+def _candidate_signature(ea_id, tm_id, wd_id, status, confidence, matched_on, is_best) -> tuple:
+    return (
+        int(ea_id) if ea_id is not None else None,
+        int(tm_id) if tm_id is not None else None,
+        wd_id,
+        status,
+        round(float(confidence), 9) if confidence is not None else None,
