+        structural = ("$ref" in p or "oneOf" in p or p.get("type") == "object"
+                      or (p.get("type") == "array" and "$ref" in p.get("items", {})))
+        if not structural and "x-source" not in p and "x-derived" not in p:
+            missing.append(f"{s_}.{n}")
+    assert missing == []
