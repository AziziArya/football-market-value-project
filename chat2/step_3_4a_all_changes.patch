+def drop_unchanged_match_results(con: duckdb.DuckDBPyConnection, results: list[MatchResult]) -> list[MatchResult]:
+    """Idempotency guard for identity_matches (G9). identity_matches stays an append-only audit trail of
+    DISTINCT outcomes: a result is skipped only when the latest stored group for the same EA id has an identical
+    candidate set (ids, status, confidence, matched_on, is_best). A changed outcome (new transfermarkt data,
+    changed thresholds, ...) is NOT skipped, so history is preserved and the newest group wins in read models
+    (latest by matched_at, then id). Results without an EA id are always kept. Nothing is deleted or edited.
+    persist_identity_matches() itself is unchanged: it remains the plain append primitive."""
+    if not results:
+        return []
+    rows = con.execute(
+        "select ea_fc26_id, transfermarkt_id, wikidata_id, match_status, match_confidence, matched_on, is_best, "
+        "match_group_id, matched_at, id from identity_matches where ea_fc26_id is not null"
+    ).fetchall()
+    groups: dict[str, dict] = {}
+    for ea_id, tm_id, wd_id, status, conf, on, best, gid, at, rid in rows:
+        g = groups.setdefault(gid, {"ea": ea_id, "order": (at, rid), "sig": []})
+        g["order"] = max(g["order"], (at, rid))
+        g["sig"].append(_candidate_signature(ea_id, tm_id, wd_id, status, conf, on, best))
+    latest: dict[int, tuple] = {}
+    for g in groups.values():
+        cur = latest.get(g["ea"])
+        if cur is None or g["order"] > cur[0]:
+            latest[g["ea"]] = (g["order"], tuple(sorted(g["sig"], key=repr)))
+
+    kept = []
+    for result in results:
+        candidates = result.all_candidates or ([result.best] if result.best else [])
+        if not candidates or candidates[0].ea_fc26_id is None:
+            kept.append(result)
+            continue
+        best_ids = (result.best.ea_fc26_id, result.best.transfermarkt_id, result.best.wikidata_id) if result.best else None
+        sig = tuple(sorted(
+            (_candidate_signature(c.ea_fc26_id, c.transfermarkt_id, c.wikidata_id, c.status, c.confidence,
+                                  ",".join(c.matched_on),
+                                  best_ids is not None and (c.ea_fc26_id, c.transfermarkt_id, c.wikidata_id) == best_ids)
+             for c in candidates), key=repr))
+        stored = latest.get(int(candidates[0].ea_fc26_id))
+        if stored is not None and stored[1] == sig:
+            continue
+        kept.append(result)
+    return kept
+
