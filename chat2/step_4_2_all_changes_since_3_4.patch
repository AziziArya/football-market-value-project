+def _check_enum(migration_glob, table_hint):
+    text = "".join(p.read_text() for p in sorted(MIGRATIONS.glob(migration_glob)))
+    m = re.search(table_hint + r".*?IN \(([^)]*)\)", text, re.S)
+    return [x.strip().strip("'") for x in m.group(1).split(",")]
