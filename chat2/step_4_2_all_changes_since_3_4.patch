+def mask(node):
+    if isinstance(node, dict):
+        return {k: ("<masked>" if k in VOLATILE and v is not None else mask(v)) for k, v in node.items()}
+    if isinstance(node, list):
+        return [mask(v) for v in node]
+    return node
