@@ -0,0 +1,329 @@
+"""getPlayerMarketValue (Step 4.4) over HTTP, on the REAL 16,107-player database built by the real pipeline,
+plus altered private copies for ordering / tie / honesty cases."""
+import hashlib
+import logging
+import random
+import re
+import shutil
+from datetime import date
+
+import duckdb
+import pytest
+from fastapi.testclient import TestClient
+
+from api.app import create_app
+from api.config import ApiConfig
+from tests.test_api.test_search_endpoint import count_queries, mask
+
+P = "/api/v1/players/"
+HAALAND, SALAH, VAN_DRONGELEN, VINI, MBAPPE, SAKA, BELLINGHAM = 239085, 209331, 233097, 238794, 231747, 246669, 252371
+CANONICAL = (MBAPPE, VINI, HAALAND, SAKA, BELLINGHAM)
+UID_RE = re.compile(r"\bp:[0-9a-f]{8}-[0-9a-f]{4}-")
+UID = "(select player_uid from v_players where ea_fc26_id = %d)"
+TOP_KEYS = {"player_id", "availability", "points", "latest", "meta"}
+POINT_KEYS = {"amount_eur", "valuation_date", "source", "dataset_version", "data_origin"}
+
+
+@pytest.fixture(scope="module")
+def client(full_db):
+    logging.getLogger("api").setLevel(logging.CRITICAL)
+    with TestClient(create_app(ApiConfig(db_path=full_db)), raise_server_exceptions=False) as c:
+        yield c
+
+
+def mv(client, ea_id):
+    r = client.get(f"{P}ea:{ea_id}/market-value")
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def profile(client, ea_id):
+    return client.get(f"{P}ea:{ea_id}").json()
+
+
+def alter(db_copy, *statements):
+    con = duckdb.connect(str(db_copy))
+    for s in statements:
+        con.execute(s)
+    con.close()
+
+
+def insert(db_copy, ea_id, rows):
+    """rows: (value_eur, 'YYYY-MM-DD', source|None, dataset_version, imported_at)."""
+    con = duckdb.connect(str(db_copy))
+    nxt = con.execute("select coalesce(max(id), 0) + 1 from market_value_history").fetchone()[0]
+    for i, (value, d, source, version, imported) in enumerate(rows):
+        con.execute(f"insert into market_value_history (id, player_uid, player_id_in_source, value_eur, valuation_date, source, dataset_version, imported_at) "
+                    f"values (?, {UID % ea_id}, 'x', ?, ?, ?, ?, ?)", [nxt + i, value, d, source, version, imported])
+    con.close()
+
+
+# ============================== contract conformance ==============================
+def test_haaland_equals_the_contract_example(client, contract, validate):
+    body = mv(client, HAALAND)
+    validate("MarketValueResponse", body)
+    want = contract["components"]["examples"]["market_value_haaland"]["value"]
+    assert {k: v for k, v in body.items() if k != "meta"} == {k: v for k, v in want.items() if k != "meta"}
+    assert body["meta"]["contract_version"] == want["meta"]["contract_version"] and body["meta"]["contains_sample_data"] is True
+
+
+def test_ea_only_equals_the_contract_example(client, contract, validate):
+    body = mv(client, SALAH)
+    validate("MarketValueResponse", body)
+    want = contract["components"]["examples"]["market_value_ea_only"]["value"]
+    assert {k: v for k, v in body.items() if k != "meta"} == {k: v for k, v in want.items() if k != "meta"}
+    assert body["meta"]["contains_sample_data"] is False and body["meta"]["contract_version"] == want["meta"]["contract_version"]
+
+
+@pytest.mark.parametrize("ea_id", CANONICAL)
+def test_every_canonical_player_conforms_and_is_ordered(client, validate, ea_id):
+    body = mv(client, ea_id)
+    validate("MarketValueResponse", body)
+    assert set(body) == TOP_KEYS and body["player_id"] == f"ea:{ea_id}" and body["availability"] == "AVAILABLE"
+    keys = [(p["valuation_date"], p["dataset_version"]) for p in body["points"]]
+    assert keys == sorted(keys) and len(set(keys)) == len(keys) and body["points"]
+    assert body["latest"] == body["points"][-1]
+    assert all(set(p) == POINT_KEYS and p["data_origin"] == "SAMPLE_FIXTURE" and p["source"] == "transfermarkt_dataset" for p in body["points"])
+    assert body["meta"]["contains_sample_data"] is True
+
+
+@pytest.mark.parametrize("ea_id", CANONICAL)
+def test_latest_equals_the_profile_source_market_value(client, ea_id):
+    body, prof = mv(client, ea_id), profile(client, ea_id)["values"]["source_market_value"]
+    assert prof["availability"] == "AVAILABLE" and body["latest"]["amount_eur"] == prof["amount_eur"]
+    assert body["latest"]["valuation_date"] == prof["valuation_date"]
+    assert (body["latest"]["source"], body["latest"]["dataset_version"], body["latest"]["data_origin"]) == \
+           (prof["provenance"]["source"], prof["provenance"]["dataset_version"], prof["provenance"]["data_origin"])
+
+
+def test_points_are_exactly_the_rows_of_that_player(client, full_db):
+    con = duckdb.connect(str(full_db), read_only=True)
+    for ea_id in CANONICAL:
+        rows = con.execute(f"select value_eur, valuation_date, dataset_version from market_value_history where player_uid = {UID % ea_id} "
+                           f"order by valuation_date, dataset_version").fetchall()
+        got = [(p["amount_eur"], date.fromisoformat(p["valuation_date"]), p["dataset_version"]) for p in mv(client, ea_id)["points"]]
+        assert got == rows and rows
+    assert con.execute("select count(*) from market_value_history").fetchone()[0] == 15      # nothing else exists to be shown
+    con.close()
+
+
+# ============================== availability states ==============================
+def test_ea_only_players_are_not_matched_never_404_never_zero(client, validate):
+    ids = [r.ea_fc26_id for r in client.app.state.services.runtime.state.index.rows if r.canonical_player_uid is None]
+    sample = random.Random(44).sample(ids, 150) + [SALAH, VAN_DRONGELEN]
+    for ea_id in sample:
+        body = mv(client, ea_id)
+        assert body == {**body, "availability": "NOT_MATCHED", "points": [], "latest": None}
+        assert body["meta"]["contains_sample_data"] is False and set(body) == TOP_KEYS
+    validate("MarketValueResponse", mv(client, SALAH))
+
+
+def test_ambiguous_candidate_value_never_leaks(client):
+    body = mv(client, VAN_DRONGELEN)                           # his Transfermarkt candidate is Mbappe's (342229): must not appear
+    assert body["availability"] == "NOT_MATCHED" and body["points"] == [] and body["latest"] is None
+    assert "342229" not in client.get(f"{P}ea:{VAN_DRONGELEN}/market-value").text
+
+
+def test_canonical_without_rows_is_no_source_data(db_copy, make_client, validate):
+    alter(db_copy, f"delete from market_value_history where player_uid = {UID % HAALAND}")
+    c = make_client(db_copy)
+    r = c.get(f"{P}ea:{HAALAND}/market-value")
+    assert r.status_code == 200
+    validate("MarketValueResponse", r.json())
+    assert r.json() == {**r.json(), "availability": "NO_SOURCE_DATA", "points": [], "latest": None}
+    assert r.json()["meta"]["contains_sample_data"] is False
+    assert c.get(f"{P}ea:{HAALAND}").json()["values"]["source_market_value"]["availability"] == "NO_SOURCE_DATA"      # profile agrees
+
+
+# ============================== ordering, ties, duplicates ==============================
+def test_order_and_latest_with_ties_and_late_inserts(db_copy, make_client, validate):
+    # inserted OUT of order on purpose (an old date last, higher ids); same date under three dataset versions
+    insert(db_copy, HAALAND, [
+        (1, "2025-06-01", "transfermarkt_dataset", "zzz_newest", "2026-01-01 00:00:00"),
+        (2, "2025-06-01", "transfermarkt_dataset", "aaa_oldest", "2026-03-01 00:00:00"),
+        (3, "2022-06-01", "transfermarkt_dataset", "sample_2026-07-06", "2025-01-01 00:00:00"),
+    ])
+    c = make_client(db_copy)
+    body = c.get(f"{P}ea:{HAALAND}/market-value").json()
+    validate("MarketValueResponse", body)
+    keys = [(p["valuation_date"], p["dataset_version"]) for p in body["points"]]
+    assert keys == [("2022-06-01", "sample_2026-07-06"), ("2023-06-01", "sample_2026-07-06"), ("2024-06-01", "sample_2026-07-06"),
+                    ("2025-06-01", "aaa_oldest"), ("2025-06-01", "sample_2026-07-06"), ("2025-06-01", "zzz_newest")]
+    assert body["latest"]["dataset_version"] == "zzz_newest" and body["latest"]["amount_eur"] == 1 and body["latest"] == body["points"][-1]
+    assert c.get(f"{P}ea:{HAALAND}").json()["values"]["source_market_value"]["amount_eur"] == 1       # profile selects the same row
+
+
+def test_highest_date_wins_over_newest_import(db_copy, make_client):
+    insert(db_copy, HAALAND, [(5, "2020-01-01", "transfermarkt_dataset", "zzz", "2030-01-01 00:00:00")])    # newest import, OLD date
+    body = make_client(db_copy).get(f"{P}ea:{HAALAND}/market-value").json()
+    assert body["latest"]["valuation_date"] == "2025-06-01" and body["points"][0]["valuation_date"] == "2020-01-01"
+
+
+def test_rows_with_the_same_logical_key_collapse_to_the_latest_import(db_copy, make_client):
+    insert(db_copy, HAALAND, [(777, "2025-06-01", "transfermarkt_dataset", "sample_2026-07-06", "2099-01-01 00:00:00")])
+    c = make_client(db_copy)
+    body = c.get(f"{P}ea:{HAALAND}/market-value").json()
+    assert len(body["points"]) == 3 and body["latest"]["amount_eur"] == 777
+    assert c.get(f"{P}ea:{HAALAND}").json()["values"]["source_market_value"]["amount_eur"] == 777
+
+
+def test_rows_of_other_players_or_unlinked_rows_are_never_included(db_copy, make_client):
+    alter(db_copy, "insert into market_value_history (id, player_uid, player_id_in_source, value_eur, valuation_date, source, dataset_version, imported_at) "
+                   "values (9001, NULL, '418560', 5, DATE '2031-01-01', 'transfermarkt_dataset', 'sample_2026-07-06', now())")      # Haaland's source id, but never linked
+    c = make_client(db_copy)
+    assert [p["amount_eur"] for p in c.get(f"{P}ea:{HAALAND}/market-value").json()["points"]] == [180000000, 200000000, 200000000]
+    assert 5 not in [p["amount_eur"] for i in CANONICAL for p in c.get(f"{P}ea:{i}/market-value").json()["points"]]
+
+
+def test_null_source_is_omitted_and_unknown_never_presented_as_real_or_sample(db_copy, make_client, validate):
