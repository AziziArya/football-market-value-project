+def test_only_market_value_history_is_read(client):
+    seen = []
+    db = client.app.state.services.db
+    original = db.cursor
+    from contextlib import contextmanager
+
+    class Spy:
+        def __init__(self, cur): self._cur = cur
+        def execute(self, sql, *a, **k):
+            seen.append(" ".join(sql.split()).lower())
+            return self._cur.execute(sql, *a, **k)
+        def __getattr__(self, n): return getattr(self._cur, n)
+
+    @contextmanager
+    def spying():
+        with original() as cur:
+            yield Spy(cur)
+    db.cursor = spying
+    try:
+        mv(client, HAALAND)
+    finally:
+        db.cursor = original
+    assert len(seen) == 1 and "from market_value_history" in seen[0]
+    for other in ("ea_fc26_attributes", "player_field_values", "identity_matches", "injury", "player_images", "v_players", "join"):
+        assert other not in seen[0]
+
