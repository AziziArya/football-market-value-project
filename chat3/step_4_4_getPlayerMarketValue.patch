@@ -0,0 +1,41 @@
+"""getPlayerMarketValue response (contract components MarketValuePoint / MarketValueResponse).
+Source market value ONLY: no EA in-game value, no model estimate, no derived trend/difference fields."""
+from __future__ import annotations
+
+from datetime import date
+
+from pydantic import ConfigDict, model_serializer
+
+from api.domain.enums import Availability, DataOrigin
+from api.schemas.common import ResponseMeta
+from api.schemas.player import _Model
+
+
+def _source_is_optional(schema: dict) -> None:
+    """`source` may be omitted from a point (NULL column), so the generated OpenAPI must not list it as required (contract)."""
+    schema["required"] = [name for name in schema.get("required", []) if name != "source"]
+
+
+class MarketValuePoint(_Model):
+    model_config = ConfigDict(json_schema_extra=_source_is_optional)
+
+    amount_eur: int
+    valuation_date: date
+    source: str | None = None            # contract: optional string. A NULL source column is omitted, never invented
+    dataset_version: str
+    data_origin: DataOrigin
+
+    @model_serializer(mode="wrap")
+    def _omit_missing_source(self, handler):
+        data = handler(self)
+        if data.get("source") is None:
+            data.pop("source", None)
+        return data
+
+
+class MarketValueResponse(_Model):
+    player_id: str
+    availability: Availability
+    points: list[MarketValuePoint]
+    latest: MarketValuePoint | None
+    meta: ResponseMeta
