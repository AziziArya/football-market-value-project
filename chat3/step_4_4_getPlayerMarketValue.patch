             **summary.model_dump(), provenance=provenance,
             meta=ResponseMeta(contract_version=CONTRACT_VERSION, generated_at=datetime.now(timezone.utc).replace(microsecond=0),
                               contains_sample_data=player_summary.contains_sample_data(summary)))
+
+    def market_value(self, raw_player_id: str) -> MarketValueResponse:
+        """getPlayerMarketValue: the source market-value history of one player, from market_value_history only.
+        EA-only => 200 NOT_MATCHED (no database access, nothing inferred); canonical without rows => 200 NO_SOURCE_DATA;
+        well-formed unknown id => 404. No EA value, no model estimate, no derived fields."""
+        state = self._runtime.state
+        if not state.ok:
+            raise data_unavailable()
+        ea_id = parse_player_id(raw_player_id)
+        if ea_id is None:
+            raise invalid_player_id()
+        row = state.index.get(ea_id)
+        if row is None:
+            raise player_not_found(raw_player_id)
+
+        rows = []
+        if row.entity_kind is EntityKind.CANONICAL:
+            try:
+                with self._db.cursor() as cur:
+                    rows = player_detail_repository.market_value_history(cur, row.canonical_player_uid)
+            except DatabaseUnavailable:
+                raise data_unavailable()
+            availability = Availability.AVAILABLE if rows else Availability.NO_SOURCE_DATA
+        else:
+            availability = Availability.NOT_MATCHED
+
+        points = [MarketValuePoint(amount_eur=r.value_eur, valuation_date=r.valuation_date, source=r.source,
+                                   dataset_version=r.dataset_version, data_origin=origin_for(r.source)) for r in rows]
+        return MarketValueResponse(
+            player_id=f"ea:{ea_id}", availability=availability, points=points, latest=points[-1] if points else None,
+            meta=ResponseMeta(contract_version=CONTRACT_VERSION, generated_at=datetime.now(timezone.utc).replace(microsecond=0),
+                              contains_sample_data=any(p.data_origin is DataOrigin.SAMPLE_FIXTURE for p in points)))
