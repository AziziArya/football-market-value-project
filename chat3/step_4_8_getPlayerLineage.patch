+def test_ambiguous_player_shows_no_candidate_id_value_or_source(client, full_db):
+    body = lin(client, VAN_DRONGELEN)
+    assert body["identity"]["links"]["transfermarkt"] == {"status": "AMBIGUOUS", "confidence": None, "matched_on": None,
+                                                         "reference_data_origin": "SAMPLE_FIXTURE", "review_pending": True}
+    assert body["identity"]["source_ids"]["transfermarkt_id"] is None
