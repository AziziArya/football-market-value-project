+    assert body["identity"]["links"]["transfermarkt"]["status"] == "UNMATCHED" and body["identity"]["links"]["wikidata"]["status"] == "NOT_EVALUATED"
+    assert {v["source"] for f in body["fields"] for v in f["values"]} == {"ea_fc26"}
+    assert all(len(f["values"]) == 1 and f["values"][0]["data_origin"] == "REAL_FULL" for f in body["fields"])
