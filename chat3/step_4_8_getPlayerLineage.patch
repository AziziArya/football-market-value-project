+"""getPlayerLineage (Step 4.8) over HTTP, on the REAL 16,107-player database built by the real pipeline, plus altered private copies.
+
+What the endpoint shows: the identity block (the very one getPlayer shows) and every STORED field value, per field and per source, never merged.
+What it never shows: an internal uid / record id, anything from an unlinked or AMBIGUOUS candidate, anything derived or inferred."""
+import hashlib
+import logging
+import random
+import re
+import shutil
+from contextlib import contextmanager
+
+import duckdb
+import pytest
+from fastapi.testclient import TestClient
+
+from api.app import create_app
+from api.config import ApiConfig
+from tests.test_api.test_search_endpoint import count_queries, mask
+
+P = "/api/v1/players/"
+HAALAND, SALAH, VAN_DRONGELEN, VINI, MBAPPE, SAKA, BELLINGHAM = 239085, 209331, 233097, 238794, 231747, 246669, 252371
+CANONICAL = (MBAPPE, VINI, HAALAND, SAKA, BELLINGHAM)
+SAMPLE = (*CANONICAL, SALAH, VAN_DRONGELEN)
+UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)
+UID = "(select player_uid from players where ea_fc26_id = %d)"
+TOP_KEYS = {"player_id", "identity", "fields", "meta"}
+VALUE_KEYS = {"field_value", "source", "dataset_version", "fetched_at", "is_current", "data_origin"}
+SIX_FIELDS = ["club", "date_of_birth", "display_name", "nationality", "position", "preferred_foot"]
+# what the AMBIGUOUS candidate of Van Drongelen (Transfermarkt id 342229 = Mbappe's record) holds in the database. His date of birth (1998-12-20) is
+# deliberately NOT listed: it is ALSO Van Drongelen's own EA value (that is exactly why the match is AMBIGUOUS, matched_on = dob), so it is not a leak.
+CANDIDATE_LEAKS = ("342229", "Kylian Mbapp", "Centre-Forward", "transfermarkt_dataset")      # the SOURCE name (the bare word is a legitimate identity key)
+
+
+@pytest.fixture
+def full_copy(full_db, tmp_path):
+    """A private writable copy of the FULL database (the small one has no AMBIGUOUS player: Van Drongelen only exists here)."""
+    dst = tmp_path / "full_copy.duckdb"
+    shutil.copy(full_db, dst)
+    return dst
+
+
+@pytest.fixture(scope="module")
+def client(full_db):
+    logging.getLogger("api").setLevel(logging.CRITICAL)
+    with TestClient(create_app(ApiConfig(db_path=full_db)), raise_server_exceptions=False) as c:
+        yield c
+
+
+def lin(client, ea_id):
+    r = client.get(f"{P}ea:{ea_id}/lineage")
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def alter(db_copy, *statements):
+    con = duckdb.connect(str(db_copy))
+    for s in statements:
+        con.execute(s)
+    con.close()
+
+
+def iso(ts):
+    return ts.replace(microsecond=0).strftime("%Y-%m-%dT%H:%M:%SZ") if ts is not None else None
+
+
+def flat(body):
+    """[(field_name, field_value, source, dataset_version, fetched_at, is_current)] in response order."""
+    return [(f["field_name"], v["field_value"], v["source"], v["dataset_version"], v["fetched_at"], v["is_current"])
+            for f in body["fields"] for v in f["values"]]
+
+
+def stored(con, ea_id):
+    """What the database holds for a player, by the rule the endpoint documents (canonical: player_uid; EA-only: unlinked ea_fc26 rows)."""
+    where = f"player_uid = {UID % ea_id}" if con.execute("select count(*) from players where ea_fc26_id = ?", [ea_id]).fetchone()[0] else \
+        f"source = 'ea_fc26' and source_record_id = '{ea_id}'"
+    return [(r[0], r[1], r[2], r[3], iso(r[4]), r[5]) for r in con.execute(
+        f"select field_name, field_value, source, dataset_version, fetched_at, is_current from player_field_values where {where} "
+        f"order by field_name, source").fetchall()]
+
+
+@contextmanager
+def spy_sql(client):
+    seen, db = [], client.app.state.services.db
+    original = db.cursor
+
+    class Spy:
+        def __init__(self, cur): self._cur = cur
+        def execute(self, sql, params=None, *a, **k):
+            seen.append((" ".join(sql.split()).lower(), list(params) if params is not None else None))
+            return self._cur.execute(sql, params, *a, **k) if params is not None else self._cur.execute(sql, *a, **k)
+        def __getattr__(self, n): return getattr(self._cur, n)
+
+    @contextmanager
+    def spying():
+        with original() as cur:
+            yield Spy(cur)
+    db.cursor = spying
+    try:
+        yield seen
+    finally:
+        db.cursor = original
+
+
+def insert_value(db_copy, *, uid_sql="NULL", field="display_name", value="x", source="ea_fc26", record="999", fetched="2030-01-01 00:00:00",
+                 version="v", current="TRUE"):
+    con = duckdb.connect(str(db_copy))
+    nid = con.execute("select max(id) + 1 from player_field_values").fetchone()[0]
+    con.execute(f"insert into player_field_values (id, player_uid, field_name, field_value, source, source_record_id, fetched_at, dataset_version, is_current) "
+                f"values (?, {uid_sql}, ?, ?, ?, ?, ?, {('NULL' if version is None else '?')}, {current})",
+                [nid, field, value, source, record, fetched] + ([] if version is None else [version]))
+    con.close()
+
