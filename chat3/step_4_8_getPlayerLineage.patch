+# RM8 - lineage of ONE player (getPlayerLineage): every stored field value, one row per source and field. Reads player_field_values only.
+# A canonical player's rows are linked by player_uid; an EA-only player's rows are unlinked and keyed by (source 'ea_fc26', source_record_id = ea id).
+# The second branch is restricted to 'ea_fc26' on purpose: an unlinked row of ANY other source can only be a candidate and is never selected.
+# Selection rule of every read model: the LATEST row per logical key (source, source_record_id, field_name), order fetched_at DESC, id DESC;
+# `is_current` is not a selection signal. Output order: field_name, source (= registry order today), source_record_id (never exposed).
+LINEAGE_FIELD_VALUES = """
+select field_name, field_value, source, dataset_version, fetched_at, is_current from (
+  select *, row_number() over (partition by source, source_record_id, field_name order by fetched_at desc, id desc) as rn
+  from player_field_values
+  where player_uid = ? or (source = 'ea_fc26' and source_record_id = ?)
+) where rn = 1
+order by field_name asc, source asc, source_record_id asc
+"""
