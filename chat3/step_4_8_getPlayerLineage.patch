+"""getPlayerLineage response (contract components FieldValue / LineageField / LineageResponse).
+Stored field values exactly as they are, one entry per source and field; disagreeing sources are BOTH listed, never merged or ranked.
+No internal id of any kind (no player uid, no source record id) and no value of an unlinked candidate."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from api.domain.enums import DataOrigin
+from api.schemas.common import ResponseMeta
+from api.schemas.player import Identity, _Model
+
+
