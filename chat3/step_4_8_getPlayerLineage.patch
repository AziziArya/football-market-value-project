+    validate("LineageResponse", body)
+    assert set(body) == TOP_KEYS and body["player_id"] == f"ea:{ea_id}"
+    assert [f["field_name"] for f in body["fields"]] == SIX_FIELDS                       # sorted by field_name, all six fields exist for everyone
+    for f in body["fields"]:
+        assert set(f) == {"field_name", "values"} and f["values"]
+        sources = [v["source"] for v in f["values"]]
+        assert sources == sorted(sources) and len(set(sources)) == len(sources)          # one entry per source, registry order (= alphabetical today)
+        assert all(set(v) == VALUE_KEYS for v in f["values"])
