+    from api.repositories import player_detail_repository as repo
+    from api.repositories.exceptions import DatabaseUnavailable
+    c = make_client(small_db)
+
+    def unavailable(*a, **k):
+        raise DatabaseUnavailable("duckdb exploded at /secret/path.duckdb: select * from player_field_values")
+    monkeypatch.setattr(repo, "lineage_field_values", unavailable)
+    r = c.get(f"{P}ea:{HAALAND}/lineage")
+    assert r.status_code == 503 and r.json()["code"] == "DATA_UNAVAILABLE"
+    validate("Problem", r.json())
