+    want = contract["components"]["examples"]["lineage_vini"]["value"]
+    assert body["identity"] == want["identity"] and body["player_id"] == want["player_id"]
+    got = {f["field_name"]: f["values"] for f in body["fields"]}
+    for f in want["fields"]:                                         # every example field, in the same order of sources, with the same values
+        strip = lambda vs: [{k: v for k, v in x.items() if k != "fetched_at"} for x in vs]
+        assert strip(got[f["field_name"]]) == strip(f["values"]), f["field_name"]
+    assert [f["field_name"] for f in body["fields"]] == SIX_FIELDS
+    extra = set(got) - {f["field_name"] for f in want["fields"]}
+    assert extra == {"preferred_foot"}                                # the database holds it (EA only); the example lists 5 of the 6 EA fields
+    assert [v["source"] for v in got["preferred_foot"]] == ["ea_fc26"] and got["preferred_foot"][0]["field_value"] == "Right"
+    assert body["meta"]["contract_version"] == want["meta"]["contract_version"] and body["meta"]["contains_sample_data"] is True
