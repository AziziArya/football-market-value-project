+def test_unexpected_failures_are_500_problems_for_every_route_without_leaks(client, monkeypatch, validate):
+    from api.services import player_summary
+
+    def boom(*args, **kwargs):
+        raise RuntimeError("secret internals /home/x/football_intel.duckdb select * from players Traceback")
+    urls = {"profile": f"{P}ea:{HAALAND}", "ea": f"{P}ea:{HAALAND}/ea-attributes", "lineage": f"{P}ea:{HAALAND}/lineage", "search": f"{P}search?q=haaland",
+            "market": f"{P}ea:{HAALAND}/market-value"}
+    # which routes must fail when a shared helper fails (exactly these; every other route is untouched and must keep answering 200)
+    # (call graph, read from the code: build_summary <- profile + search; build_summary -> build_identity + ea_ingame_value -> ea_provenance;
+    #  ea-attributes -> ea_ingame_value + ea_provenance; lineage -> build_identity; market-value uses none of them)
+    must_fail = {"build_summary": {"profile", "search"}, "build_identity": {"profile", "search", "lineage"},
+                 "ea_ingame_value": {"profile", "search", "ea"}, "ea_provenance": {"profile", "search", "ea"}}
+    assert all(client.get(u).status_code == 200 for u in urls.values())                          # control: nothing fails without the patch
+    for target, failing in must_fail.items():
+        monkeypatch.setattr(player_summary, target, boom)
+        for name, url in urls.items():
+            response = client.get(url)
+            assert response.status_code == (500 if name in failing else 200), (target, name, response.status_code)
+            if name in failing:
+                assert response.headers["content-type"] == "application/problem+json" and response.json()["code"] == "INTERNAL_ERROR"
+                validate("Problem", response.json())
+                assert_clean_error(response, ("secret", "football_intel"))
+        monkeypatch.undo()
