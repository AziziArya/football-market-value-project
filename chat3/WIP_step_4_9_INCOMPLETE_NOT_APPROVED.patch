+# ---------------------------------------------------------------------------------------------- 5. read-only and determinism, for the whole API
+def sweep(client, ids):
+    out = {}
+    for ea_id in ids:
+        for route, response in get_all(client, ea_id).items():
+            out[(ea_id, route)] = mask(response.json())
+    for q in ("haaland", "an", "vinicius"):
+        out[("search", q)] = mask(client.get(f"{P}search?q={q}&limit=20").json())
+    out["health"] = mask(client.get("/api/v1/health").json())
+    out["freshness"] = mask(client.get("/api/v1/data-freshness").json())
+    return out
