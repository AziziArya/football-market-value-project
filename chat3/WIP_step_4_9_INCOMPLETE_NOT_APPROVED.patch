+def test_serving_the_whole_api_never_modifies_the_database_and_is_deterministic(full_db, tmp_path):
+    path = tmp_path / "ro.duckdb"
+    shutil.copy(full_db, path)
+    digest, mtime = hashlib.sha256(path.read_bytes()).hexdigest(), os.stat(path).st_mtime_ns
+    ids = [*SAMPLE, 100000, 190000, 230000, 250000]
+    with TestClient(create_app(ApiConfig(db_path=path)), raise_server_exceptions=False) as c:
+        ids = [i for i in ids if c.get(f"{P}ea:{i}").status_code == 200]
+        first, second = sweep(c, ids), sweep(c, ids)
+        for url in (f"{P}ea:1", f"{P}p:abc", f"{P}search?q=a", "/nope"):
+            c.get(url)
+        for call in (c.post, c.put, c.delete, c.patch):
+            call(f"{P}ea:{HAALAND}")
+    assert first == second and len(first) >= 5 * len(SAMPLE)
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == digest and os.stat(path).st_mtime_ns == mtime
+    assert not [f for f in os.listdir(tmp_path) if f != "ro.duckdb"]                       # no WAL / temp file was created next to the database
