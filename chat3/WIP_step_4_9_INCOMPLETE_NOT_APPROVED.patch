+# ---------------------------------------------------------------------------------------------- 1. the generated spec vs the contract, as a whole
+def resolve(spec, node):
+    while isinstance(node, dict) and "$ref" in node:
+        target = spec
+        for part in node["$ref"].lstrip("#/").split("/"):
+            target = target[part]
+        node = {**target, **{k: v for k, v in node.items() if k != "$ref"}}                  # siblings of a $ref (e.g. a default) override
+    return node
+
+
+def effective(spec, schema):
+    """The constraints that matter to a client, ignoring titles/descriptions and the generator's `anyOf [X, null]` wrapping of optional parameters."""
+    schema = resolve(spec, schema)
+    if "anyOf" in schema:
+        branches = [effective(spec, b) for b in schema["anyOf"] if b.get("type") != "null"]
+        assert len(branches) == 1
+        return {**branches[0], **{k: v for k, v in schema.items() if k in ("default",)}}
+    return {k: v for k, v in schema.items() if k in ("type", "minLength", "maxLength", "minimum", "maximum", "enum", "default", "pattern")}
+
+
+def flat_schema(spec, schema):
+    """(property names, required names, enum) of a schema with $ref and allOf flattened."""
+    schema = resolve(spec, schema)
+    props, required = set(schema.get("properties", {})), set(schema.get("required", []))
+    for part in schema.get("allOf", []):
+        p, r, _ = flat_schema(spec, part)
+        props |= p
+        required |= r
+    return props, required, schema.get("enum")
+
+
+def test_generated_spec_has_no_422_no_validation_schemas_and_no_dangling_refs(generated):
