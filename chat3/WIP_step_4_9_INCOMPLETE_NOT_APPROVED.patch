+def assert_clean_error(response, hostile=()):
+    """For ERROR bodies (the words below could legitimately occur in a club or a player name of a SUCCESS body, so those only get the structural check)."""
+    text = response.text
+    if response.status_code >= 400:
+        for pattern in ERROR_BODY_FORBIDDEN:
+            assert not pattern.search(text), (pattern.pattern, text[:200])
+    for structural in (r"canonical_player_uid", r"player_uid", r"source_record_id", r"\.duckdb", r"/home/", r"/mnt/", r"traceback"):
+        assert not re.search(structural, text, re.I), structural
+    assert not UUID_RE.search(text)
+    for fragment in hostile:
+        assert fragment not in text, fragment
