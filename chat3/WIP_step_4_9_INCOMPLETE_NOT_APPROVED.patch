+    422 can never be returned and the contract does not define it. (Fixed in Step 4.9.)"""
+    text = json.dumps(generated)
+    assert '"422"' not in text and "ValidationError" not in text
+    refs = set(re.findall(r'"\$ref": "#/components/schemas/([^"]+)"', text))
+    assert refs <= set(generated["components"]["schemas"])
+
