+def test_hostile_search_input_is_only_echoed_in_its_normalised_form(client, validate):
+    """The contract echoes `query_normalized` (lower-case ASCII letters and digits, single spaces, at most 80 characters): nothing else of `q` is reflected."""
+    for label, qs in {"sql": "q=ab'%20OR%201=1--", "script": "q=%3Cscript%3Ealert(1)%3C/script%3E", "null": "q=ab%00cd", "newline": "q=ab%0acd", "unicode": "q=%C3%A9%C3%A9%F0%9F%98%80",
+                      "long": "q=" + "a" * 5000, "club": "q=ab&club=%27%3BDROP%20TABLE%20players--", "bad limit": "q=ab&limit=%3Cscript%3E", "bad sort": "q=ab&sort=%3Cb%3E",
+                      "bad kind": "q=ab&entity_kind=%3Cb%3E", "bad min": "q=ab&min_overall=1e9"}.items():
+        response = client.get(f"{P}search?{qs}")
+        assert response.status_code in (200, 400), label
+        assert_clean_error(response, ("OR 1=1", "DROP", "<script", "<b>", "a" * 100))
+        if response.status_code == 400:
+            assert response.headers["content-type"] == "application/problem+json" and response.json()["code"] == "INVALID_PARAMETER"
+            validate("Problem", response.json())
+        else:
+            validate("SearchResponse", response.json())
+            echoed = response.json()["query_normalized"]
+            assert re.fullmatch(r"([a-z0-9]+( [a-z0-9]+)*)?", echoed) and len(echoed) <= 80, (label, echoed)           # no markup, quote, ; or control character survives
