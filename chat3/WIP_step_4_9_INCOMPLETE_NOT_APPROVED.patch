+HOSTILE_IDS = {
+    "sql": "ea:1'%20OR%201=1--", "sql2": "ea:1;DROP%20TABLE%20players", "script": "%3Cscript%3Ealert(1)%3C/script%3E", "traversal": "..%2F..%2Fetc%2Fpasswd",
+    "traversal2": "....//....//etc/passwd", "crlf": "ea:1%0d%0aX-Evil:1", "null byte": "ea:1%00", "unicode digit": "ea:%EF%BC%91", "long": "ea:" + "9" * 5000,
+    "uuid": "p:3943921e-6d70-4677-acb2-bceb4988cf07", "bare uuid": "3943921e-6d70-4677-acb2-bceb4988cf07", "leading zero": "ea:01", "empty number": "ea:",
+    "uppercase": "EA:1", "plus": "ea:+1", "space": "ea:%201", "hex": "ea:0x1", "float": "ea:1.5", "negative": "ea:-1", "template": "ea:%7B%7B7*7%7D%7D",
