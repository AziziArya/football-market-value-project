+"""getPlayerInjuries (Step 4.5) over HTTP, on the REAL 16,107-player database built by the real pipeline.
+
+IMPORTANT: no injury source exists. The real database therefore only ever contains `NO_SOURCE_AVAILABLE` rows and no
+injury_records. The HAS_RECORDS / CONFIRMED_NO_INJURIES cases below use SYNTHETIC rows inserted into THROWAWAY COPIES of the
+database, purely to prove the endpoint passes stored values through honestly and derives nothing. They are not football data."""
+import hashlib
+import logging
+import random
+import re
+import shutil
+from contextlib import contextmanager
+from datetime import date
+
+import duckdb
+import pytest
+from fastapi.testclient import TestClient
+
+from api.app import create_app
+from api.config import ApiConfig
+from tests.test_api.test_search_endpoint import count_queries, mask
+
+P = "/api/v1/players/"
+HAALAND, SALAH, VAN_DRONGELEN, VINI, MBAPPE, SAKA, BELLINGHAM = 239085, 209331, 233097, 238794, 231747, 246669, 252371
+CANONICAL = (MBAPPE, VINI, HAALAND, SAKA, BELLINGHAM)
+UID_RE = re.compile(r"\bp:[0-9a-f]{8}-[0-9a-f]{4}-")
+UID = "(select player_uid from v_players where ea_fc26_id = %d)"
+TOP_KEYS = {"player_id", "injury", "records", "meta"}
+RECORD_KEYS = {"injury_type", "start_date", "expected_return", "actual_return", "days_out", "source"}
+
+
+@pytest.fixture(scope="module")
+def client(full_db):
+    logging.getLogger("api").setLevel(logging.CRITICAL)
+    with TestClient(create_app(ApiConfig(db_path=full_db)), raise_server_exceptions=False) as c:
+        yield c
+
+
+def inj(client, ea_id):
+    r = client.get(f"{P}ea:{ea_id}/injuries")
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def alter(db_copy, *statements):
+    con = duckdb.connect(str(db_copy))
+    for s in statements:
+        con.execute(s)
+    con.close()
+
+
+def set_status(db_copy, ea_id, status):
+    alter(db_copy, f"update injury_data_status set status = '{status}' where player_uid = {UID % ea_id}")
+
+
+def add_records(db_copy, ea_id, rows, uid=None):
+    """rows: (injury_type, start_date, expected_return, actual_return, days_out, source) - SYNTHETIC test values."""
+    con = duckdb.connect(str(db_copy))
+    nxt = con.execute("select coalesce(max(id), 0) + 1 from injury_records").fetchone()[0]
+    for i, r in enumerate(rows):
+        con.execute(f"insert into injury_records (id, player_uid, injury_type, start_date, expected_return, actual_return, days_out, source, imported_at) "
+                    f"values (?, {uid or UID % ea_id}, ?, ?, ?, ?, ?, ?, now())", [nxt + i, *r])
+    con.close()
+
+
+@contextmanager
+def spy_sql(client):
+    seen, db = [], client.app.state.services.db
+    original = db.cursor
+
+    class Spy:
+        def __init__(self, cur): self._cur = cur
+        def execute(self, sql, *a, **k):
+            seen.append(" ".join(sql.split()).lower())
+            return self._cur.execute(sql, *a, **k)
+        def __getattr__(self, n): return getattr(self._cur, n)
+
+    @contextmanager
+    def spying():
+        with original() as cur:
+            yield Spy(cur)
+    db.cursor = spying
+    try:
+        yield seen
+    finally:
+        db.cursor = original
+
+
+SYNTHETIC = [  # inserted OUT of order on purpose; NULL dates; days_out deliberately inconsistent with the dates
+    ("synthetic-b", "2025-03-01", "2025-04-01", "2025-05-01", 999, "synthetic_source"),
+    ("synthetic-null-start", None, None, None, None, None),
+    ("synthetic-a", "2024-01-10", None, "2024-01-20", None, "synthetic_source"),
+    ("synthetic-c", "2025-03-01", "2025-03-15", None, 7, "synthetic_source"),
+    ("synthetic-tie-1", "2023-05-05", "2023-06-06", None, 5, "synthetic_source"),      # identical sort keys: the id decides (insertion order)
+    ("synthetic-tie-2", "2023-05-05", "2023-06-06", None, 5, "synthetic_source"),
+]
+
+
+# ============================== contract conformance ==============================
+def test_canonical_equals_the_contract_example(client, contract, validate):
+    body = inj(client, HAALAND)
+    validate("InjuriesResponse", body)
+    want = contract["components"]["examples"]["injuries_canonical"]["value"]
+    assert {k: v for k, v in body.items() if k not in ("meta", "injury")} == {k: v for k, v in want.items() if k not in ("meta", "injury")}
+    assert body["injury"]["status"] == want["injury"]["status"] == "NO_SOURCE_AVAILABLE"
+    assert re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", body["injury"]["checked_at"])
+    assert body["meta"]["contract_version"] == want["meta"]["contract_version"] and body["meta"]["contains_sample_data"] is False
+
+
+def test_ea_only_equals_the_contract_example(client, contract, validate):
+    body = inj(client, SALAH)
+    validate("InjuriesResponse", body)
+    want = contract["components"]["examples"]["injuries_ea_only"]["value"]
+    assert {k: v for k, v in body.items() if k != "meta"} == {k: v for k, v in want.items() if k != "meta"}
+    assert body["meta"]["contains_sample_data"] is False
+
+
+def test_contract_marks_the_endpoint_schema_only(contract):
+    assert contract["paths"]["/players/{player_id}/injuries"]["get"]["x-status"] == "SCHEMA_ONLY"      # served honestly; records always []
+
+
+@pytest.mark.parametrize("ea_id", CANONICAL)
+def test_every_canonical_player_is_no_source_available_never_healthy(client, validate, ea_id):
+    body = inj(client, ea_id)
+    validate("InjuriesResponse", body)
+    assert set(body) == TOP_KEYS and body["player_id"] == f"ea:{ea_id}" and set(body["injury"]) == {"status", "checked_at"}
+    assert body["injury"]["status"] == "NO_SOURCE_AVAILABLE" and body["records"] == [] and body["injury"]["checked_at"].endswith("Z")
+    assert body["meta"]["contains_sample_data"] is False
+    assert "CONFIRMED_NO_INJURIES" not in client.get(f"{P}ea:{ea_id}/injuries").text      # absence of a source is never "no injuries"
+
+
+@pytest.mark.parametrize("ea_id", [*CANONICAL, SALAH, VAN_DRONGELEN])
+def test_injury_block_equals_the_one_in_getPlayer(client, ea_id):
+    assert inj(client, ea_id)["injury"] == client.get(f"{P}ea:{ea_id}").json()["injury"]
+
+
+def test_status_and_checked_at_come_from_the_database(client, full_db):
+    con = duckdb.connect(str(full_db), read_only=True)
+    for ea_id in CANONICAL:
+        status, checked = con.execute(f"select status, checked_at from injury_data_status where player_uid = {UID % ea_id}").fetchone()
+        got = inj(client, ea_id)["injury"]
+        assert got["status"] == status and got["checked_at"] == checked.strftime("%Y-%m-%dT%H:%M:%SZ")
+    assert con.execute("select count(*) from injury_records").fetchone()[0] == 0              # nothing exists to be shown
+    assert con.execute("select count(*) from injury_data_status where status <> 'NO_SOURCE_AVAILABLE'").fetchone()[0] == 0
+    con.close()
+
+
+def test_checked_at_is_passed_through_exactly_not_the_current_time(db_copy, make_client, validate):
+    """Time-independent: a fixed old value must come back unchanged (truncated to whole seconds, UTC), never `now`."""
+    alter(db_copy, f"update injury_data_status set checked_at = TIMESTAMP '2020-01-02 03:04:05.678' where player_uid = {UID % HAALAND}")
+    c = make_client(db_copy)
+    body = c.get(f"{P}ea:{HAALAND}/injuries").json()
+    validate("InjuriesResponse", body)
+    assert body["injury"] == {"status": "NO_SOURCE_AVAILABLE", "checked_at": "2020-01-02T03:04:05Z"}
+    assert c.get(f"{P}ea:{HAALAND}").json()["injury"] == body["injury"]
+    assert c.get(f"{P}ea:{VINI}/injuries").json()["injury"]["checked_at"] != "2020-01-02T03:04:05Z"      # only that player's row changed
+
+
+# ============================== availability states ==============================
+def test_ea_only_players_are_not_evaluated_never_404_never_healthy(client, validate):
+    ids = [r.ea_fc26_id for r in client.app.state.services.runtime.state.index.rows if r.canonical_player_uid is None]
+    for ea_id in random.Random(45).sample(ids, 150) + [SALAH, VAN_DRONGELEN]:
