+
+@pytest.fixture(scope="module")
+def internal_uids(client):
+    """The REAL uuids of the 5 canonical players, taken from the INTERNAL in-memory index (not from any response)."""
+    index = client.app.state.services.runtime.state.index
+    uids = {ea_id: index.get(ea_id).canonical_player_uid for ea_id in CANONICAL}
+    assert all(UUID_RE.fullmatch(u) for u in uids.values()) and len(set(uids.values())) == 5
+    return uids
