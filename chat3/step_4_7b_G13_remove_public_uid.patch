+
+def property_names(node):
+    """Every property NAME declared anywhere in a schema document (values such as x-source columns are not names)."""
+    names = set()
+    if isinstance(node, dict):
+        for key, value in node.items():
+            if key == "properties" and isinstance(value, dict):
+                names |= set(value)
+            names |= property_names(value)
+    elif isinstance(node, list):
+        for value in node:
+            names |= property_names(value)
+    return names
+
+
+def keys_anywhere(node):
+    keys = set()
+    if isinstance(node, dict):
+        for key, value in node.items():
+            keys.add(key)
+            keys |= keys_anywhere(value)
+    elif isinstance(node, list):
+        for value in node:
+            keys |= keys_anywhere(value)
+    return keys
+
+
+# ============================== 1. contract and generated OpenAPI ==============================
+def test_contract_version_is_0_5_0_draft_everywhere(contract):
+    assert contract["info"]["version"] == CONTRACT_VERSION == "0.5.0-draft"
+    versions = {e["value"]["meta"]["contract_version"] for e in contract["components"]["examples"].values() if "meta" in e["value"]}
+    assert versions == {"0.5.0-draft"}
+    assert "0.4.0" not in json.dumps(contract)
+
+
+def test_contract_declares_no_uid_property_and_no_uid_anywhere(contract):
+    text = json.dumps(contract)
+    assert "canonical_player_uid" not in text
+    assert not [n for n in property_names(contract) if "uid" in n.lower()]
+    assert not UUID_RE.search(text)                                  # not even a sandbox uuid left in an example
+    assert set(contract["components"]["schemas"]["Identity"]["properties"]) == IDENTITY_KEYS
+    assert set(contract["components"]["schemas"]["Identity"]["required"]) == IDENTITY_KEYS
+
+
+def test_every_example_identity_has_exactly_the_public_keys(contract):
+    seen = 0
+    for name, ex in contract["components"]["examples"].items():
+        def walk(node):
+            nonlocal seen
+            if isinstance(node, dict):
+                if "entity_kind" in node and "source_ids" in node:
+                    assert set(node) == IDENTITY_KEYS, name
+                    seen += 1
+                for v in node.values():
+                    walk(v)
+            elif isinstance(node, list):
+                for v in node:
+                    walk(v)
+        walk(ex["value"])
+    assert seen >= 8                                                  # profile x3, lineage x1, search items x4 (at least)
+
