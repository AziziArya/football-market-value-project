@@ -0,0 +1,328 @@
+"""getPlayerEaAttributes (Step 4.6) over HTTP, on the REAL 16,107-player database built by the real pipeline.
+
+Scope today = what the database really holds: overall, potential, preferred foot and the EA IN-GAME value (never a market value, never a
+model estimate). Detailed attributes are PLANNED (G1: ea_fc26_attributes.raw_json is NULL for every row): NOT_YET_INTEGRATED / null.
+Everything is served from the in-memory read model RM1 (the row getPlayer uses): there is no database access for ANY player."""
+import hashlib
+import logging
+import random
+import re
+import shutil
+from datetime import timezone
+
+import duckdb
+import pytest
+from fastapi.testclient import TestClient
+
+from api.app import create_app
+from api.config import ApiConfig
+from tests.test_api.test_search_endpoint import count_queries, mask
+
+P = "/api/v1/players/"
+HAALAND, SALAH, VAN_DRONGELEN, VINI, MBAPPE, SAKA, BELLINGHAM = 239085, 209331, 233097, 238794, 231747, 246669, 252371
+CANONICAL = (MBAPPE, VINI, HAALAND, SAKA, BELLINGHAM)
+SAMPLE = (*CANONICAL, SALAH, VAN_DRONGELEN)
+UID_RE = re.compile(r"\bp:[0-9a-f]{8}-[0-9a-f]{4}-")
+TOP_KEYS = {"player_id", "overall_rating", "potential", "preferred_foot", "ea_ingame_value", "detailed_attributes", "provenance", "meta"}
+PLANNED = {"availability": "NOT_YET_INTEGRATED", "attributes": None}
+
+
+@pytest.fixture(scope="module")
+def client(full_db):
+    logging.getLogger("api").setLevel(logging.CRITICAL)
+    with TestClient(create_app(ApiConfig(db_path=full_db)), raise_server_exceptions=False) as c:
+        yield c
+
+
+def ea(client, ea_id):
+    r = client.get(f"{P}ea:{ea_id}/ea-attributes")
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def alter(db_copy, *statements):
+    con = duckdb.connect(str(db_copy))
+    for s in statements:
+        con.execute(s)
+    con.close()
+
+
+def iso(ts):
+    return ts.replace(microsecond=0, tzinfo=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if ts is not None else None
+
+
+# ============================== contract conformance ==============================
+def test_salah_equals_the_contract_example(client, contract, validate):
+    body = ea(client, SALAH)
+    validate("EaAttributesResponse", body)
+    want = contract["components"]["examples"]["ea_attributes_salah"]["value"]
+
+    def core(d):                                   # fetched_at is the load time of THIS database; meta carries generated_at
+        d = {k: v for k, v in d.items() if k != "meta"}
+        for block in (d["provenance"], d["ea_ingame_value"]["provenance"]):
+            block.pop("fetched_at")
+        return d
+    assert core(body) == core(want)
+    assert body["meta"]["contract_version"] == want["meta"]["contract_version"] and body["meta"]["contains_sample_data"] is False
+
+
+@pytest.mark.parametrize("ea_id", SAMPLE)
+def test_canonical_and_ea_only_players_conform(client, validate, ea_id):
+    body = ea(client, ea_id)
+    validate("EaAttributesResponse", body)
+    assert set(body) == TOP_KEYS and body["player_id"] == f"ea:{ea_id}"
+    assert body["detailed_attributes"] == PLANNED
+    assert body["ea_ingame_value"]["availability"] == "AVAILABLE" and body["ea_ingame_value"]["provenance"] == body["provenance"]
+    assert body["provenance"]["source"] == "ea_fc26" and body["provenance"]["data_origin"] == "REAL_FULL"
+    assert body["provenance"]["dataset_version"] == "2025-09-19"
+    assert body["meta"]["contains_sample_data"] is False
+
+
+def test_contract_marks_the_endpoint_implementable_today(contract):
+    assert contract["paths"]["/players/{player_id}/ea-attributes"]["get"]["x-status"] == "IMPLEMENTABLE_TODAY"
+    assert contract["components"]["schemas"]["EaDetailedAttributes"]["x-status"] == "PLANNED"
+
+
+def test_every_one_of_the_16107_players_matches_the_database_exactly(client, full_db):
+    """Whole-population check at service level (no HTTP): each response equals the stored row; nothing is invented, rounded or defaulted."""
+    con = duckdb.connect(str(full_db), read_only=True)
+    rows = con.execute("""
+        select a.ea_fc26_id, a.overall_rating, a.potential, a.value_eur_ingame, a.dataset_version,
+               (select max(f.field_value) from player_field_values f where f.source = 'ea_fc26' and f.field_name = 'preferred_foot'
+                  and f.source_record_id = cast(a.ea_fc26_id as varchar)),
+               (select max(f.fetched_at) from player_field_values f where f.source = 'ea_fc26'
+                  and f.source_record_id = cast(a.ea_fc26_id as varchar))
+        from ea_fc26_attributes a order by 1""").fetchall()
+    con.close()
+    assert len(rows) == 16107
+    svc = client.app.state.services.player
+    for ea_id, overall, potential, value, version, foot, fetched in rows:
+        r = svc.ea_attributes(f"ea:{ea_id}").model_dump(mode="json")
+        assert (r["overall_rating"], r["potential"], r["preferred_foot"]) == (overall, potential, foot)
+        assert r["ea_ingame_value"]["amount_eur"] == value and r["ea_ingame_value"]["availability"] == "AVAILABLE"
+        assert r["provenance"] == {"source": "ea_fc26", "dataset_version": version, "fetched_at": iso(fetched), "data_origin": "REAL_FULL"}
+        assert r["ea_ingame_value"]["provenance"] == r["provenance"] and r["detailed_attributes"] == PLANNED
+
+
+def test_ea_only_and_canonical_players_get_the_same_kind_of_answer(client):
+    ea_only = [r.ea_fc26_id for r in client.app.state.services.runtime.state.index.rows if r.canonical_player_uid is None]
+    for ea_id in random.Random(46).sample(ea_only, 200) + [SALAH, VAN_DRONGELEN]:
+        body = ea(client, ea_id)
+        assert body["ea_ingame_value"]["availability"] == "AVAILABLE" and set(body) == TOP_KEYS      # never NOT_MATCHED: everyone has an EA row
+    for ea_id in CANONICAL:
+        assert ea(client, ea_id)["ea_ingame_value"]["availability"] == "AVAILABLE"
+
+
+@pytest.mark.parametrize("ea_id", SAMPLE)
+def test_values_equal_the_ones_in_getPlayer_and_search(client, ea_id):
+    body, prof = ea(client, ea_id), client.get(f"{P}ea:{ea_id}").json()
+    assert (body["overall_rating"], body["potential"], body["preferred_foot"]) == (prof["overall_rating"], prof["potential"], prof["preferred_foot"])
+    assert body["ea_ingame_value"] == prof["values"]["ea_ingame_value"]
+    assert body["provenance"] == prof["provenance"][0]                                       # the EA source is always the first provenance entry
+    item = [i for i in client.get(f"{P}search?q={prof['display_name']}&limit=50").json()["items"] if i["id"] == f"ea:{ea_id}"][0]
+    assert item["values"]["ea_ingame_value"] == body["ea_ingame_value"] and item["overall_rating"] == body["overall_rating"]
+
+
+# ============================== planned / honest nulls ==============================
+def test_detailed_attributes_are_planned_never_invented(client):
+    for ea_id in SAMPLE:
+        text = client.get(f"{P}ea:{ea_id}/ea-attributes").text
+        assert ea(client, ea_id)["detailed_attributes"] == PLANNED
+        for attribute in ("pace", "shooting", "passing", "dribbling", "defending", "physic", "finishing", "acceleration", "sprint", "stamina", "strength",
+                          "weak_foot", "skill_moves", "work_rate", "reputation"):
+            assert attribute not in text.lower(), attribute
+
+
+def test_g1_premise_raw_json_is_null_for_every_row(full_db):
+    """The PLANNED block is honest ONLY while the database does not store the detailed attributes. When the data-integrity step (G1) stores them,
+    this test fails on purpose: the endpoint's detailed_attributes block must then be implemented, not left at NOT_YET_INTEGRATED."""
+    con = duckdb.connect(str(full_db), read_only=True)
+    assert con.execute("select count(*) from ea_fc26_attributes where raw_json is not null").fetchone()[0] == 0
+    assert con.execute("select count(*) from ea_fc26_attributes").fetchone()[0] == 16107
+    con.close()
+
+
+def test_null_ea_value_is_no_source_data_never_zero(db_copy, make_client, validate):
+    alter(db_copy, f"update ea_fc26_attributes set value_eur_ingame = NULL where ea_fc26_id = {SALAH}")
+    c = make_client(db_copy)
+    r = c.get(f"{P}ea:{SALAH}/ea-attributes")
+    assert r.status_code == 200
+    validate("EaAttributesResponse", r.json())
+    v = r.json()["ea_ingame_value"]
+    assert v["availability"] == "NO_SOURCE_DATA" and v["amount_eur"] is None and v["provenance"] == r.json()["provenance"]
+    assert r.json()["overall_rating"] == 91                                                  # the rest of the row is still served
+    assert c.get(f"{P}ea:{SALAH}").json()["values"]["ea_ingame_value"] == v                 # profile agrees
+
+
+def test_null_preferred_foot_stays_null_and_the_key_is_present(db_copy, make_client, validate):
+    alter(db_copy, f"delete from player_field_values where source = 'ea_fc26' and field_name = 'preferred_foot' and source_record_id = '{SALAH}'")
+    body = make_client(db_copy).get(f"{P}ea:{SALAH}/ea-attributes").json()
+    validate("EaAttributesResponse", body)
+    assert body["preferred_foot"] is None and "preferred_foot" in body
+
+
+def test_load_timestamp_cannot_be_null_and_a_player_without_ea_rows_fails_closed(db_copy, make_client, validate):
+    """player_field_values.fetched_at is NOT NULL, so the contract's nullable provenance.fetched_at never actually occurs; and a player whose EA
+    field rows are all missing (no display_name) is rejected by the existing startup invariant: nothing is served, nothing is invented."""
+    con = duckdb.connect(str(db_copy))
+    with pytest.raises(duckdb.ConstraintException):
+        con.execute(f"update player_field_values set fetched_at = NULL where source = 'ea_fc26' and source_record_id = '{SALAH}'")
+    con.execute(f"delete from player_field_values where source = 'ea_fc26' and source_record_id = '{SALAH}'")
+    con.close()
+    r = make_client(db_copy).get(f"{P}ea:{HAALAND}/ea-attributes")
+    assert r.status_code == 503 and r.json()["code"] == "DATA_UNAVAILABLE"
+    validate("Problem", r.json())
+
+
+def test_fetched_at_is_passed_through_exactly_not_the_current_time(db_copy, make_client, validate):
+    """Time-independent: a fixed old load timestamp must come back unchanged (whole seconds, UTC), for both provenance blocks, never `now`."""
+    alter(db_copy, f"update player_field_values set fetched_at = TIMESTAMP '2020-01-02 03:04:05.678' where source = 'ea_fc26' and source_record_id = '{SALAH}'")
+    c = make_client(db_copy)
+    body = c.get(f"{P}ea:{SALAH}/ea-attributes").json()
+    validate("EaAttributesResponse", body)
+    assert body["provenance"]["fetched_at"] == body["ea_ingame_value"]["provenance"]["fetched_at"] == "2020-01-02T03:04:05Z"
+    assert c.get(f"{P}ea:{SALAH}").json()["values"]["ea_ingame_value"]["provenance"]["fetched_at"] == "2020-01-02T03:04:05Z"
+    assert ea(c, HAALAND)["provenance"]["fetched_at"] != "2020-01-02T03:04:05Z"                  # only that player's rows changed
+
+
+def test_null_ratings_fail_the_whole_service_closed(db_copy, make_client, validate):
+    """The contract says overall_rating/potential are non-null integers although the columns are nullable: the existing startup invariant
+    (integrity_service) enforces it by refusing to serve ANYTHING, so this endpoint can never emit a null rating."""
+    alter(db_copy, f"update ea_fc26_attributes set overall_rating = NULL where ea_fc26_id = {SALAH}")
+    c = make_client(db_copy)
+    for pid in (f"ea:{SALAH}", f"ea:{HAALAND}", "ea:1"):
+        r = c.get(f"{P}{pid}/ea-attributes")
+        assert r.status_code == 503 and r.json()["code"] == "DATA_UNAVAILABLE"
+        validate("Problem", r.json())
+
+
+# ============================== value domains never mix ==============================
+def test_ea_value_is_independent_of_market_value_and_vice_versa(db_copy, make_client, tmp_path):
+    only_mv, only_ea = tmp_path / "only_market_value_changed.duckdb", tmp_path / "only_ea_value_changed.duckdb"
+    shutil.copy(db_copy, only_mv)
+    shutil.copy(db_copy, only_ea)
+    alter(only_mv, "update market_value_history set value_eur = 1")
+    alter(only_ea, f"update ea_fc26_attributes set value_eur_ingame = 5 where ea_fc26_id = {HAALAND}")
+    base, c_mv, c_ea = make_client(db_copy), make_client(only_mv), make_client(only_ea)
+
+    before_ea, before_mv = ea(base, HAALAND), base.get(f"{P}ea:{HAALAND}/market-value").json()
+    assert before_ea["ea_ingame_value"]["amount_eur"] == 157000000 and before_mv["latest"]["amount_eur"] == 200000000      # two different numbers
+    assert "200000000" not in base.get(f"{P}ea:{HAALAND}/ea-attributes").text
+    # ONLY the market value changed: the EA response is identical (ignoring generated_at)
+    assert mask(ea(c_mv, HAALAND)) == mask(before_ea)
+    assert c_mv.get(f"{P}ea:{HAALAND}/market-value").json()["latest"]["amount_eur"] == 1
+    # ONLY the EA value changed: the market-value response does not move
+    assert ea(c_ea, HAALAND)["ea_ingame_value"]["amount_eur"] == 5
+    assert mask(c_ea.get(f"{P}ea:{HAALAND}/market-value").json()) == mask(before_mv)
+
+
+def test_no_market_model_identity_or_other_domain_in_the_response(client):
+    forbidden = ("market", "model", "predict", "estimate", "injur", "trend", "diff", "delta", "change", "percent", "canonical", "identity", "link",
+                 "transfermarkt", "wikidata", "image", "uid", "valuation")
+    for ea_id in SAMPLE:
+        text = client.get(f"{P}ea:{ea_id}/ea-attributes").text
+        keys = set(re.findall(r'"([a-z_]+)":', text))
+        assert not any(f in k for k in keys for f in forbidden), keys
+        assert not UID_RE.search(text) and "transfermarkt" not in text.lower() and "wikidata" not in text.lower()
+    assert set(ea(client, HAALAND)["ea_ingame_value"]) == {"availability", "amount_eur", "provenance"}
+
+
+# ============================== errors ==============================
+def test_unknown_well_formed_id_is_a_real_404_problem(client, validate):
+    r = client.get(f"{P}ea:1/ea-attributes")
+    assert r.status_code == 404 and r.headers["content-type"].startswith("application/problem+json")
+    validate("Problem", r.json())
+    assert r.json()["code"] == "PLAYER_NOT_FOUND" and r.json()["instance"] == f"{P}ea:1/ea-attributes"
+
+
+@pytest.mark.parametrize("bad", ["239085", "ea:", "EA:1", "ea:01", "ea:-1", "ea:1x", "ea:1234567890", "p:abc", "p:3943921e-6d70-4677-acb2-bceb4988cf07",
+                                 "search", "ea:1;DROP TABLE players"])
+def test_malformed_ids_are_400_and_the_value_is_not_reflected(client, validate, bad):
+    r = client.get(f"{P}{bad}/ea-attributes")
+    assert r.status_code == 400 and r.headers["content-type"].startswith("application/problem+json")
+    validate("Problem", r.json())
+    assert r.json()["code"] == "INVALID_PLAYER_ID" and r.json()["instance"] is None and "DROP" not in r.text
+
+
+def test_writes_are_rejected_405(client):
+    for call in (client.post, client.put, client.delete, client.patch):
+        assert call(f"{P}ea:{HAALAND}/ea-attributes").status_code == 405
+
+
+def test_503_when_the_database_is_unavailable_from_the_start(tmp_path, make_client, validate):
+    c = make_client(tmp_path / "missing.duckdb")
+    for pid in ("ea:239085", "ea:209331", "ea:1", "ea:1x"):          # the health gate comes first, before id validation
+        r = c.get(f"{P}{pid}/ea-attributes")
+        assert r.status_code == 503 and r.json()["code"] == "DATA_UNAVAILABLE"
+        validate("Problem", r.json())
+
+
+def test_served_from_memory_even_if_the_database_disappears_after_startup(small_db, make_client):
+    c = make_client(small_db)
+    before = mask(ea(c, HAALAND))
+    c.app.state.services.db.close()
+    assert mask(ea(c, HAALAND)) == before and ea(c, SALAH)["overall_rating"] == 91      # canonical AND EA-only: no database access exists
+    assert c.get(f"{P}ea:1/ea-attributes").status_code == 404 and c.get(f"{P}p:abc/ea-attributes").status_code == 400
+
+
+def test_unexpected_failure_is_a_500_problem_without_leaks(small_db, make_client, monkeypatch):
+    from api.services import player_summary
+    c = make_client(small_db)
+
+    def boom(*a, **k):
+        raise RuntimeError("secret internals /secret/path select * from x")
+    monkeypatch.setattr(player_summary, "ea_ingame_value", boom)
+    r = c.get(f"{P}ea:{HAALAND}/ea-attributes")
+    assert r.status_code == 500 and r.json()["code"] == "INTERNAL_ERROR" and r.headers["content-type"].startswith("application/problem+json")
+    assert "secret" not in r.text and "select" not in r.text.lower()
+
+
+# ============================== OpenAPI / conformance ==============================
+def test_generated_openapi_matches_the_contract(small_db, make_client, contract):
+    gen = make_client(small_db, enable_docs=True).get("/openapi.json").json()["components"]["schemas"]
+    for name in ("EaAttributesResponse", "EaDetailedAttributes"):
+        want = contract["components"]["schemas"][name]
+        assert set(gen[name]["properties"]) == set(want["properties"]), name
+        assert set(want["required"]) <= set(gen[name]["required"]), name
+        assert gen[name].get("additionalProperties") is False
+    # whatever is generated as required beyond the contract must really be always serialized: preferred_foot (null included) is the only one
+    assert set(gen["EaAttributesResponse"]["required"]) - set(contract["components"]["schemas"]["EaAttributesResponse"]["required"]) == {"preferred_foot"}
+    assert set(gen["EaDetailedAttributes"]["required"]) == {"availability", "attributes"}
+    attrs = gen["EaDetailedAttributes"]["properties"]["attributes"]
+    assert {"type": "null"} in attrs["anyOf"] and any(o.get("additionalProperties") == {"type": "integer"} for o in attrs["anyOf"])
+
+
+# ============================== queries, read-only, determinism ==============================
+def test_no_database_access_at_all(client, monkeypatch):
+    """The strongest form of the query-count check: opening a cursor is made impossible and every player is still served."""
+    db = client.app.state.services.db
+
+    def forbidden(*a, **k):
+        raise AssertionError("getPlayerEaAttributes must not touch the database")
+    monkeypatch.setattr(db, "cursor", forbidden)
+    for ea_id in SAMPLE:
+        assert ea(client, ea_id)["player_id"] == f"ea:{ea_id}"
+    assert client.get(f"{P}ea:1/ea-attributes").status_code == 404 and client.get(f"{P}p:abc/ea-attributes").status_code == 400
+
+
+def test_query_count_is_zero(client):
+    with count_queries(client) as c:
+        for ea_id in SAMPLE:
+            ea(client, ea_id)
+        client.get(f"{P}ea:1/ea-attributes"); client.get(f"{P}ea:abc/ea-attributes")
+    assert c["n"] == 0
+
+
+def test_deterministic_and_never_modifies_the_database(full_db, tmp_path):
+    path = tmp_path / "ro.duckdb"
+    shutil.copy(full_db, path)
+    before = hashlib.sha256(path.read_bytes()).hexdigest()
+    with TestClient(create_app(ApiConfig(db_path=path))) as c:
+        a = [mask(c.get(f"{P}ea:{i}/ea-attributes").json()) for i in SAMPLE]
+        b = [mask(c.get(f"{P}ea:{i}/ea-attributes").json()) for i in SAMPLE]
+        assert a == b
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == before
+
+
