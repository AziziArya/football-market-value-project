+
+from api.domain.enums import Availability
+from api.schemas.common import ResponseMeta
+from api.schemas.player import EaIngameValue, SourceProvenance, _Model
+
+
+class EaDetailedAttributes(_Model):
+    """PLANNED (contract x-status): the detailed EA attributes are not stored in the database yet (raw_json is NULL for every row, G1)."""
+    availability: Availability
+    attributes: dict[str, int] | None
+
+
+class EaAttributesResponse(_Model):
+    player_id: str
+    overall_rating: int
+    potential: int
+    preferred_foot: str | None
+    ea_ingame_value: EaIngameValue
+    detailed_attributes: EaDetailedAttributes
